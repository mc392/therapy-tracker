.idea/
.claude/

# Local data & backups — NEVER commit real client data to this (public) repo
therapy-tracker-data*.json
therapy-tracker-backup-*.json

# Local push helper and its output
push-now.bat
push-result.txt

# ---- Native iOS wrapper (Capacitor) ----
# The web app in TherapyTracker-web/ is the single source of truth. Everything the
# wrapper derives from it is generated, never committed, so a stale copy cannot drift.
node_modules/
ios/App/App/public/

# Derived artwork: 9MB of PNGs copied out of icon-ideas/groundwork/ by
# scripts/install-assets.mjs on every sync. The sources are already in the repo; committing
# six near-duplicates of them, again on every artwork change, is not worth it. Contents.json
# IS committed — that is the configuration, not the output.
ios/App/App/Assets.xcassets/Splash.imageset/*.png
ios/App/App/Assets.xcassets/AppIcon.appiconset/*.png
ios/App/GroundWorkWatch/Assets.xcassets/AppIcon.appiconset/*.png

# GroundWork Plus licence signing key, if anyone writes one into the tree.
# The real one lives outside the repo (see scripts/issue-licence.mjs).
licence-key.json

# Output of scripts/review-test-data.mjs when no directory is given.
.test-data-review/
